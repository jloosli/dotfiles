[user]
	name = Jared Loosli
	email = jloosli@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[pull]
	rebase = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[include]
	path = ~/.config/git/config.local
